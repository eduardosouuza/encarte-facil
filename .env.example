# Servidor (API local do Encarte Facil)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Segredo usado para assinar os JWTs das sessoes.
# Em producao o servidor nao sobe sem este valor.
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=7d

# Origem do frontend (CORS e links publicos). Use "*" para permitir qualquer origem.
APP_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Banco de dados SQLite. Use ":memory:" para testes em memoria.
DATABASE_FILE=./data/encarte-facil.sqlite

# Custo do bcrypt (10 por padrao).
BCRYPT_ROUNDS=10

# Credenciais do usuario de demonstracao criado pelo seed.
SEED_ADMIN_EMAIL=demo@encartefacil.com
SEED_ADMIN_PASSWORD=demo12345
SEED_DEMO_PASSWORD=demo12345

# Frontend: alvo do proxy do Vite (usado em dev e preview).
VITE_API_PROXY=http://127.0.0.1:3001
